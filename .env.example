# The database file - SQLite, so this is just a local file path, no setup needed.
DATABASE_URL="file:./dev.db"

# Optional for now. Slack -> Apps -> "Incoming Webhooks" -> add to a channel -> paste URL here.
# Without this set, notifications just log to the terminal instead of failing.
SLACK_WEBHOOK_URL=

# Google OAuth login. Free — Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret NextAuth uses to encrypt sessions. Generate one with:
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional for now. Stripe dashboard -> Developers -> API keys -> Create restricted key.
# Set permissions to EXACTLY: Invoices = Write, Customers = Read, everything else = None.
# This key cannot charge cards, issue refunds, or touch payouts — draft invoices only.
STRIPE_RESTRICTED_KEY=

# Recall.ai - the "join Zoom and listen" tool. Get a key at recall.ai (5 free hours to start).
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Anthropic API key - powers the "AI reads the transcript and figures out the deal terms" step.
# Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Random secret that proves a webhook call actually came from Recall.ai.
# Generate one with: openssl rand -hex 16
# Then set the Recall.ai webhook URL to: https://yourapp.com/api/calls/webhook?secret=<this value>
WEBHOOK_SECRET=
